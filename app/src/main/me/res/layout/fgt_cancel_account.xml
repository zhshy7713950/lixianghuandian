<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#2E3440">

    <include
        layout="@layout/layout_topbar" />

    <TextView
        android:id="@+id/tvTitle1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_marginTop="57dp"
        android:text="1.为保障您的权益，我们在此提醒您，若您的账号（%s）下："/>

    <TextView
        android:id="@+id/tvTip1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle1"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="\n1）存在「电池未归还」的情况、或者「押金未退还」的情况，请先联系我们的客户人员进行人工处理，号码400-0283969；或者自行在「首页」进行「退还电池」的操作\n\n2）存在「租电套餐仍在有效期」的情况、或者「换电套餐仍在有效期」的情况，请于注销前消耗完毕。否则，我们将视为您自愿放弃该套餐剩余权益"
        />

    <TextView
        android:id="@+id/tvTitle2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvTip1"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_marginTop="50dp"
        android:text="2.验证手机号码："/>

    <TextView
        android:id="@+id/tvTip2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle2"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textSize="14sp"
        android:textColor="#9A9A9A"
        android:layout_marginLeft="12dp"
        android:text="当前号码"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/tvTip2"
        app:layout_constraintBottom_toBottomOf="@+id/tvTip2"
        app:layout_constraintLeft_toRightOf="@+id/tvTip2"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_marginLeft="20dp"
        android:text="1111"
        />

    <TextView
        android:id="@+id/tvTip3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvTip2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/etCode"
        android:textSize="14sp"
        android:textColor="#9A9A9A"
        android:layout_marginLeft="12dp"
        android:text="验证码   "
        android:layout_marginTop="20dp"
        />

    <EditText
        android:id="@+id/etCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="@+id/tvTip3"
        app:layout_constraintBottom_toBottomOf="@+id/tvTip3"
        app:layout_constraintLeft_toRightOf="@+id/tvTip3"
        app:layout_constraintRight_toRightOf="parent"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:hint="请输入验证码"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="12dp"
        android:theme="@style/CodeEditTextStyle"
        android:inputType="numberSigned"
        />

    <Button
        android:id="@+id/btnCancelAccount"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="42dp"
        android:background="@drawable/bg_gradient_color_btn"
        android:text="注销账号"
        android:textColor="#272934"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnSendCode"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnCancelAccount"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_gradient_color_btn"
        android:text="发送验证码"
        android:textColor="#272934"
        android:textSize="15sp"
        android:textStyle="bold"/>


</androidx.constraintlayout.widget.ConstraintLayout>