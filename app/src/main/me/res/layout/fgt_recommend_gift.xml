<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D83D3E">

    <com.qmuiteam.qmui.widget.QMUITopBar
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#D83D3E"
        app:layout_constraintTop_toTopOf="parent"
        app:qmui_topbar_title_color="@color/white" />

    <TextView
        android:id="@+id/tv_big_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="邀请好友领福利"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_bottom_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/image_invite_friend_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_big_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_invite_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="邀请码"
                        android:textColor="#3E3E3E"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_invite_code_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="--"
                        android:textColor="#F96C51"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:text="您的好友在注册时也可填写邀请码"
                        android:textColor="#908F8F"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="207dp"
                        android:layout_height="188dp">

                        <ImageView
                            android:layout_width="207dp"
                            android:layout_height="188dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/image_code_border" />

                        <ImageView
                            android:id="@+id/iv_invite_qrcode"
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_gravity="center"
                            android:scaleType="fitXY" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/btn_share_invite_code"
                        android:layout_width="114dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="30dp"
                        android:gravity="center"
                        android:background="@drawable/bg_recommend_gift_button"
                        android:text="分享邀请码"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_invite_strategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="25dp"
                        android:text="邀请攻略"
                        android:textColor="#3E3E3E"
                        android:textSize="16sp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <ImageView
                            android:id="@+id/iv_share"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_share_invitation_code"
                            app:layout_constraintEnd_toStartOf="@+id/iv_arrow1"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginLeft="22dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="分享邀请码"
                            android:textColor="#3E3E3E"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@+id/iv_share"
                            app:layout_constraintStart_toStartOf="@+id/iv_share"
                            app:layout_constraintTop_toBottomOf="@+id/iv_share" />

                        <ImageView
                            android:id="@+id/iv_arrow1"
                            android:layout_width="0dp"
                            android:layout_height="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_recommend_arrow"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_share"
                            app:layout_constraintEnd_toStartOf="@+id/iv_bind"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/iv_share"
                            app:layout_constraintTop_toTopOf="@+id/iv_share" />

                        <ImageView
                            android:id="@+id/iv_bind"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_invite_to_bind"
                            app:layout_constraintEnd_toStartOf="@+id/iv_arrow2"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/iv_arrow1"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="邀请好友\n扫码绑定"
                            android:textColor="#3E3E3E"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@+id/iv_bind"
                            app:layout_constraintStart_toStartOf="@+id/iv_bind"
                            app:layout_constraintTop_toBottomOf="@+id/iv_bind" />

                        <ImageView
                            android:id="@+id/iv_arrow2"
                            android:layout_width="0dp"
                            android:layout_height="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_recommend_arrow"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_bind"
                            app:layout_constraintEnd_toStartOf="@+id/iv_pay"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/iv_bind"
                            app:layout_constraintTop_toTopOf="@+id/iv_bind" />

                        <ImageView
                            android:id="@+id/iv_pay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_friend_pay"
                            app:layout_constraintEnd_toStartOf="@+id/iv_arrow3"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/iv_arrow2"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="好友购买\n好友续租"
                            android:textColor="#3E3E3E"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@+id/iv_pay"
                            app:layout_constraintStart_toStartOf="@+id/iv_pay"
                            app:layout_constraintTop_toBottomOf="@+id/iv_pay" />

                        <ImageView
                            android:id="@+id/iv_arrow3"
                            android:layout_width="0dp"
                            android:layout_height="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_recommend_arrow"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_pay"
                            app:layout_constraintEnd_toStartOf="@+id/iv_reward"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/iv_pay"
                            app:layout_constraintTop_toTopOf="@+id/iv_pay" />

                        <ImageView
                            android:id="@+id/iv_reward"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_reward_credited"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/iv_arrow3"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginRight="22dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="奖励到账"
                            android:textColor="#3E3E3E"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@+id/iv_reward"
                            app:layout_constraintStart_toStartOf="@+id/iv_reward"
                            app:layout_constraintTop_toBottomOf="@+id/iv_reward" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/btn_my_reward"
                        android:layout_width="114dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="35dp"
                        android:gravity="center"
                        android:background="@drawable/bg_recommend_gift_button"
                        android:text="我的奖励"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

