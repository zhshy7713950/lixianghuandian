<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginLeft="12dp"
    android:orientation="vertical"
    android:layout_marginRight="12dp"
    android:layout_marginTop="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/cl_coupon"
        android:background="@drawable/bg_ticket_me"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_coupon_info"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/ll_line_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvRmb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥"

                    android:layout_marginLeft="26dp"
                    android:textSize="20sp"
                    android:textColor="#F9BB6C"
                    />

                <TextView
                    android:id="@+id/tv_money"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="60.00"
                    android:textColor="#F9BB6C"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_coupon_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="优惠券"
                    android:textColor="#fff9bb6c"
                    android:textSize="14sp"
                    />

            </LinearLayout>


            <TextView
                android:id="@+id/tv_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="满199可使用"
                android:textColor="#ffffffff"
                android:textSize="12sp"
                android:maxLines="2"
                app:layout_constraintTop_toBottomOf="@+id/ll_line_1"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_marginTop="2dp"
                android:layout_marginHorizontal="26dp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_use"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="去使用"
            android:textColor="#fff9bb6c"
            android:textSize="16sp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginRight="30dp"
            />

        <ImageView
            android:id="@+id/iv_select"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/radio_select"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginRight="40dp"
            android:visibility="gone"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ticket_me_bottom"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/cl_coupon">
        <TextView
            android:id="@+id/tv_coupon_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="优惠类型："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <TextView
            android:id="@+id/tv_app_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="适用品牌："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_coupon_type"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />

        <TextView
            android:id="@+id/tv_limit_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="适用城市："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_type"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />
        <TextView
            android:id="@+id/tv_limit_voltage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="适用伏数："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_limit_city"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />
        <TextView
            android:id="@+id/tv_limit_day_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="适用天数："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_limit_voltage"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />
        <TextView
            android:id="@+id/tv_act_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生效时间："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_limit_day_desc"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />
        <TextView
            android:id="@+id/tv_exp_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="过期时间："
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_act_time"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用说明：\n(1) 本券不兑换现金、不设找零、不退不换\n(2) 本券仅限领取用户使用，不支持转赠他人"
            android:textColor="#ffffffff"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_exp_time"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginTop="5dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>