<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#2C303A" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/topbar_height">
        <com.qmuiteam.qmui.widget.QMUITopBar android:id="@+id/topbar"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:qmui_topbar_left_back_drawable_id="@drawable/ic_back_white"
            app:qmui_topbar_title_color="@color/white" />
        <TextView android:id="@+id/btn_refresh" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:layout_gravity="end"
            android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp"
            android:text="刷新" android:textColor="@android:color/white" android:textSize="16sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_marginTop="20dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingLeft="12dp" android:paddingRight="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="请选择您需要操作的站点："
            android:textColor="@android:color/white" android:textSize="16sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/btn_confirm" android:layout_width="90dp"
            android:layout_height="40dp" android:background="@drawable/bg_nearby_confirm"
            android:gravity="center" android:text="确认选择" android:textColor="@android:color/black"
            android:textSize="16sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="20dp"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/station_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingBottom="20dp" />
    </ScrollView>
</LinearLayout>
