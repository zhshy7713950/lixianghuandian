<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#272831">
    <com.qmuiteam.qmui.widget.QMUITopBar
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:orientation="vertical"
        app:qmui_topbar_left_back_drawable_id="@drawable/ic_back_white"
        app:qmui_topbar_title_color="@color/white" />
    <EditText
        android:id="@+id/etCode"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="90dp"
        android:hint="请输入编码"
        android:textSize="18sp"
        android:textColorHint="#9EAAB3"
        android:gravity="center"
        android:text=""
        android:textColor="@color/white"
        android:background="@null"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:background="@drawable/shape_line"/>
    <TextView android:id="@+id/tv_code_note1"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
        android:text="（电柜二维码下方字母/数字" android:textColor="#F4DE67"
        android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_code_note2"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="例如:DC6012005XXX1715）" android:textColor="#F4DE67"
        android:textSize="16sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/tvConfirm"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="确认"
        android:textColor="#ff272934"
        android:textSize="15sp"
        android:gravity="center"
        android:background="@drawable/bg_btn_common4"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"/>
    <LinearLayout android:id="@+id/btn_light"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="60dp"
        android:gravity="center_horizontal" android:orientation="vertical">
        <ImageView android:layout_width="54dp" android:layout_height="54dp"
            android:src="@mipmap/ic_light" android:contentDescription="手电筒" />
        <TextView android:id="@+id/tv_light" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:text="打开手电筒" android:textColor="@android:color/white"
            android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
