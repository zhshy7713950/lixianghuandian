<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:layout_marginBottom="10dp"
        android:background="@color/app_color"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="手机验证码登录"
        android:textColor="#232524"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tv_title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="30dp"
        android:text="未注册的手机号验证后将创建新账号"
        android:textColor="#666666"
        android:textSize="14sp" />


    <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundFrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        app:qmui_backgroundColor="@color/bg_gray"
        app:qmui_borderColor="@color/bg_gray"
        app:qmui_radius="5dp">

        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="@color/transparent"
            android:hint="请输入手机号码"
            android:inputType="phone"
            android:textColor="#232524"
            android:textSize="16sp" />
    </com.qmuiteam.qmui.widget.roundwidget.QMUIRoundFrameLayout>

    <!-- 图形验证码输入与图片 -->
    <LinearLayout
        android:id="@+id/layout_img_captcha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundFrameLayout
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:qmui_backgroundColor="@color/bg_gray"
            app:qmui_borderColor="@color/bg_gray"
            app:qmui_radius="5dp">

            <EditText
                android:id="@+id/et_img_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_marginRight="24dp"
                android:background="@color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="请输入图形验证码"
                android:inputType="numberSigned"
                android:textColor="#232524"
                android:textSize="16sp" />


        </com.qmuiteam.qmui.widget.roundwidget.QMUIRoundFrameLayout>


        <LinearLayout
            android:id="@+id/layout_img_captcha_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_weight="0.6"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/fl_img_captcha"
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/iv_img_captcha"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="图形验证码"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tv_img_captcha_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EEEEEE"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="图形验证码"
                    android:textColor="#000000"
                    android:textSize="16sp" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_change_captcha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_horizontal"
                android:text="看不清楚，换一张"
                android:textColor="@color/black"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>
    <!-- 验证码输入框 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundFrameLayout
            android:layout_width="0dp"
            android:layout_height="50dp"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:layout_marginBottom="10dp"
            android:layout_weight="1"
            app:qmui_backgroundColor="@color/bg_gray"
            app:qmui_borderColor="@color/bg_gray"
            app:qmui_radius="5dp">

            <EditText
                android:id="@+id/et_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@color/transparent"
                android:hint="请输入短信验证码"
                android:inputType="numberSigned"
                android:textColor="#232524"
                android:textSize="16sp" />

        </com.qmuiteam.qmui.widget.roundwidget.QMUIRoundFrameLayout>


        <com.flyco.roundview.RoundTextView
            android:id="@+id/tv_get_code"
            android:layout_width="0dp"
            android:layout_height="50dp"
			android:layout_marginRight="10dp"
			android:layout_marginLeft="10dp"
			android:layout_marginBottom="10dp"
            android:layout_weight="0.6"
            android:gravity="center"
            android:text="获取验证码"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:rv_backgroundColor="@color/app_color"
            app:rv_cornerRadius="5dp" />

    </LinearLayout>


    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="35dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_btn_common1"
        android:text="验证码登录"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnOneKey"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_login_switch"
        android:text="使用「本机号码一键登录」"
        android:textColor="@color/app_color"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:visibility="invisible">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:layout_marginLeft="40dp"
            android:layout_weight="1"
            android:background="#EBEBEB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="其他登录方式" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:layout_marginRight="40dp"
            android:layout_weight="1"
            android:background="#EBEBEB" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_wechat_login"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/wechat_login"
        android:visibility="invisible" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="40dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <CheckBox
            android:id="@+id/cb_login"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:button="@drawable/checkedbox_bg" />

        <TextView
            android:id="@+id/tv_login_protocol"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:gravity="center_vertical"
            android:textColor="#666666"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>


</LinearLayout>