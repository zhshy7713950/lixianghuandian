<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="180dp"
        android:layout_marginHorizontal="40dp"
        android:gravity="center_horizontal">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_coupon_info"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="30dp"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_inner_coupon_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:background="@drawable/bg_inner_dialog_coupon_info"
                android:paddingBottom="15dp"
                android:paddingTop="10dp"
                android:paddingHorizontal="15dp"
                >

                <TextView
                    android:id="@+id/tvMoney"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="#F9BB6C"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/tv_coupon_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="￥超值价"
                    android:textColor="#F9BB6C"
                    android:textSize="14sp"
                    app:layout_constraintLeft_toRightOf="@id/tvMoney"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvMoney"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用满199可使用"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@+id/tvMoney"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:maxLines="2"
                    android:ellipsize="end"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_coupon_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优惠类型："
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/cl_inner_coupon_info"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="10dp"
                />

            <TextView
                android:id="@+id/tv_app_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="适用品牌："
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_coupon_type"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="5dp"
                />

            <TextView
                android:id="@+id/tv_limit_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="适用城市："
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_type"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="5dp"
                />
            <TextView
                android:id="@+id/tv_limit_voltage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="适用伏数："
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_limit_city"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="5dp"
                />
            <TextView
                android:id="@+id/tv_limit_day_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="适用天数："
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_limit_voltage"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="5dp"
                />
            <TextView
                android:id="@+id/tv_act_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="有效时间："
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_limit_day_desc"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="5dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用说明：\n(1) 本券不兑换现金、不设找零、不退不换\n(2) 本券仅限领取用户使用，不支持转赠他人"
                android:textColor="#2E3441"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_act_duration"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="5dp"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_close_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dialog_coupon_info_close"
            android:layout_marginTop="50dp"/>


    </LinearLayout>



</FrameLayout>