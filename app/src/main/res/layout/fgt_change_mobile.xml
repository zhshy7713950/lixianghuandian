<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:background="@drawable/bg_background"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<include layout="@layout/layout_topbar" />

	<TextView
		android:id="@+id/tvTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="请您先完成“老手机号码”验证"
		android:textColor="#B8C7D7"
		android:layout_marginLeft="24dp"
		android:layout_marginTop="30dp"
		android:textSize="14sp"
		/>


	<EditText
		android:inputType="phone"
		android:layout_marginLeft="24dp"
		android:layout_marginRight="24dp"
		android:layout_marginTop="20dp"
		android:textSize="18sp"
		android:textColor="#666666"
		android:hint="请输入手机号码"
		android:background="@drawable/bg_login_input"
		android:id="@+id/etPhone"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:paddingLeft="10dp"
		android:paddingRight="10dp"/>

	<!-- 图形验证码输入与图片（参照登录页） -->
	<LinearLayout
		android:id="@+id/layout_img_captcha"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginLeft="24dp"
		android:layout_marginRight="24dp"
		android:layout_marginTop="20dp">

		<EditText
			android:id="@+id/et_img_code"
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="48dp"
			android:focusable="true"
			android:focusableInTouchMode="true"
			android:paddingLeft="10dp"
			android:paddingRight="10dp"
			android:background="@drawable/bg_login_input"
			android:textColor="#666666"
			android:hint="请输入图形验证码"
			android:layout_marginRight="24dp"
			android:inputType="number"/>

		<LinearLayout
			android:id="@+id/layout_img_captcha_right"
			android:layout_width="0dp"
			android:layout_weight="0.618"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<FrameLayout
				android:id="@+id/fl_img_captcha"
				android:layout_width="match_parent"
				android:layout_height="48dp">

				<ImageView
					android:id="@+id/iv_img_captcha"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:scaleType="centerCrop"
					android:contentDescription="图形验证码" />

				<TextView
					android:id="@+id/tv_img_captcha_placeholder"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center"
					android:background="#CCCCCC"
					android:text="图形验证码"
					android:textColor="#000000"
					android:textSize="14sp" />

			</FrameLayout>

			<TextView
				android:id="@+id/tv_change_captcha"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="0dp"
				android:text="看不清楚，换一张"
				android:textColor="#FFFFFFFF"
				android:textSize="11sp"
				android:gravity="center_horizontal"/>

		</LinearLayout>

	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginLeft="24dp"
		android:layout_marginRight="24dp"
		android:layout_marginTop="30dp">

		<EditText
			android:id="@+id/etCode"
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="48dp"
			android:focusable="true"
			android:inputType="number"
			android:focusableInTouchMode="true"
			android:maxLength="6"
			android:paddingLeft="10dp"
			android:paddingRight="10dp"
			android:background="@drawable/bg_login_input"
			android:textColor="#666666"
			android:hint="请输入验证码"
			android:layout_marginRight="24dp"
			/>

		<TextView
			android:id="@+id/tvGetCode"
			android:layout_width="0dp"
			android:layout_weight="0.618"
			android:layout_height="42dp"
			android:text="获取验证码"
			android:textColor="@color/black"
			android:textSize="14sp"
			android:gravity="center"
			android:background="@drawable/bg_btn_common1_8px"
			/>
		
	</LinearLayout>

	<Button
		android:id="@+id/btnOtpLogin"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginTop="58dp"
		android:layout_marginLeft="40dp"
		android:layout_marginRight="40dp"
		android:background="@drawable/bg_btn_login_8dp"
		android:textColor="@color/black"
		android:text="验证码登录"
		android:textSize="16sp"
		/>


</LinearLayout>