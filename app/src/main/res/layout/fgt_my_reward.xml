<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D83D3E">

    <com.qmuiteam.qmui.widget.QMUITopBar
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/qmui_topbar_height"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#D83D3E"
        android:fitsSystemWindows="true"/>

    <!-- Fixed Footer -->
    <ImageView
        android:id="@+id/iv_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:src="@drawable/image_invite_friend_bg"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp"> 
            
            <!-- Spacer for fixed header height (approximate 220dp) -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <!-- My Rewards Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="我的奖励"
                android:textColor="#FDF1D4"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Invite Friend Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_my_reward_center" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="邀请的好友越多，奖励越多"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- Reward Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/bg_reward_card"
                android:orientation="vertical"
                android:paddingTop="15dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Pending -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_pending_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="0元"
                            android:textColor="#F96C51"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:id="@+id/ll_pending_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="5dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="奖励待到账"
                                android:textColor="#727272"
                                android:textSize="16sp" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginLeft="2dp"
                                android:src="@drawable/ic_question_white"
                                app:tint="#727272"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#BCB9B9"/>

                    <!-- Received -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_received_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="0.2元"
                            android:textColor="#F96C51"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="奖励已到账"
                            android:textColor="#727272"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#BCB9B9"/>

                    <!-- Withdrawable -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_withdrawable_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="0元"
                            android:textColor="#F96C51"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="奖励可提现"
                            android:textColor="#727272"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_withdraw"
                    android:layout_width="114dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/shape_btn_withdraw"
                    android:gravity="center"
                    android:text="申请提现"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="（满￥10.0可提现）"
                    android:textColor="#727272"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/ll_total_withdrawn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tv_total_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="您已累计提现0.2元"
                        android:textColor="#727272"
                        android:textSize="14sp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="2dp"
                        android:src="@drawable/ic_question_white"
                        app:tint="#727272"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Invited Friends Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已邀请的好友"
                    android:textColor="#FDF1D4"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_invite_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="(共1位)"
                    android:textColor="#FDF1D4"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Friends Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/bg_reward_card"
                android:orientation="vertical"
                android:paddingBottom="20dp">
                
                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="好友姓名"
                        android:textColor="#3E3E3E"
                        android:textSize="12sp" />
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#BCB9B9"/>
                    
                    <LinearLayout
                        android:id="@+id/ll_filter_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="租赁状态"
                            android:textColor="#3E3E3E"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginLeft="2dp"
                            android:src="@drawable/ic_arraw_down"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#BCB9B9"/>

                    <LinearLayout
                        android:id="@+id/ll_potential_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="可获奖励"
                            android:textColor="#3E3E3E"
                            android:textSize="12sp" />
                         <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginLeft="1dp"
                            android:src="@drawable/ic_question_white"
                            app:tint="#3E3E3E"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#BCB9B9"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="已获奖励"
                        android:textColor="#3E3E3E"
                        android:textSize="12sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#BCB9B9" android:layout_marginLeft="20dp" android:layout_marginRight="10dp"/>

                <!-- List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_friends"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Header Elements (Overlay) -->
    <ImageView
        android:id="@+id/iv_top_bg_fixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_my_reward_top"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        android:elevation="1dp" />

    <TextView
        android:id="@+id/tv_header_title_fixed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="好友新租/续租均可获得奖励"
        android:textColor="#FDF1D4"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        android:elevation="2dp" />

    <ImageView
        android:id="@+id/iv_monthly_standard_fixed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:src="@drawable/ic_monthly_reward_standards"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title_fixed"
        android:elevation="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>