<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#2E3440">
    <include layout="@layout/layout_topbar"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="站点电池信息"
        android:textColor="#ffffffff"
        android:textSize="15sp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:padding="12dp"
        android:background="@drawable/rectangle_gray_bg">

        <!-- 站点名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="站点名称"
                android:textColor="#9EAAB3"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_site_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ffffffff"
                android:textSize="14sp"
                tools:text="三色路罗森便利店"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>

        <!-- 电柜编号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电柜编号"
                android:textColor="#9EAAB3"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_cabinet_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ffffffff"
                android:textSize="14sp"
                tools:text="DC6012005LH23081715"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>

        <!-- 电柜配置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电柜配置"
                android:textColor="#9EAAB3"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginLeft="12dp">
                
                <TextView
                    android:id="@+id/tv_cabinet_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#313944"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:background="@drawable/bg_cabinet_num"
                    android:layout_marginRight="5dp"
                    tools:text="5仓柜"
                    />

                <TextView
                    android:id="@+id/tv_full_exchange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#333333"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:background="@drawable/bg_full_exchange"
                    android:layout_marginRight="5dp"
                    android:text="满仓换电"
                    android:visibility="gone"
                    tools:visibility="visible"
                    />

                <TextView
                    android:id="@+id/tv_offline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#333333"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:background="@drawable/bg_cabinet_offline"
                    android:layout_marginRight="5dp"
                    android:text="已离线"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- 电池编号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电池编号"
                android:textColor="#9EAAB3"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_battery_num_pay_rent_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ffffffff"
                android:textSize="14sp"
                tools:text="60000012"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>

        <!-- 电池型号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电池型号"
                android:textColor="#9EAAB3"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_battery_model_pay_rent_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ffffffff"
                android:textSize="14sp"
                tools:text="48伏80安"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/package_details_layout"
        />

