<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBEBEB">

    <!-- Top Orange Background -->
    <View
        android:id="@+id/v_top_bg"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#ED5A2E"
        app:layout_constraintTop_toTopOf="parent" />

    <com.qmuiteam.qmui.widget.QMUITopBar
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/qmui_topbar_height"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="提现详情"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topbar" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_large">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="30dp">

            <!-- Icon Background -->
            <FrameLayout
                android:id="@+id/fl_icon_bg"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/shape_circle_red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_status_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    tools:src="@drawable/ic_withdraw_success" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="提现成功"
                android:textColor="#ED5A2E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_icon_bg" />

            <TextView
                android:id="@+id/tv_status_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="请及时查看到账情况，若未到账，请联系客服人员"
                android:textColor="#757474"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_status_title" />

            <!-- Divider Area -->
            <View
                android:id="@+id/v_dash_line"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/shape_line_dashed"
                android:layerType="software"
                app:layout_constraintTop_toBottomOf="@id/tv_status_desc" />

            <!-- Left Semi Circle -->
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-15dp"
                android:background="@drawable/shape_circle_gray"
                app:layout_constraintBottom_toBottomOf="@id/v_dash_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/v_dash_line" />

            <!-- Right Semi Circle -->
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="-15dp"
                android:background="@drawable/shape_circle_gray"
                app:layout_constraintBottom_toBottomOf="@id/v_dash_line"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/v_dash_line" />

            <!-- Details -->
            <!-- User -->
            <TextView
                android:id="@+id/tv_label_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="35dp"
                android:text="提现用户"
                android:textColor="#333333"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_dash_line" />

            <TextView
                android:id="@+id/tv_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="#333333"
                android:textSize="14sp"
                tools:text="黄彦超"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_label_user"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Method -->
            <TextView
                android:id="@+id/tv_label_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:text="提现方式"
                android:textColor="#333333"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_label_user" />

            <TextView
                android:id="@+id/tv_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="#333333"
                android:textSize="14sp"
                android:text="支付宝"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_label_method"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Account -->
            <TextView
                android:id="@+id/tv_label_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:text="提现账号"
                android:textColor="#333333"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_label_method" />

            <TextView
                android:id="@+id/tv_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="#333333"
                android:textSize="14sp"
                tools:text="13550160009"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_label_account"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Time -->
            <TextView
                android:id="@+id/tv_label_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:text="提现时间"
                android:textColor="#333333"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_label_account" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="#333333"
                android:textSize="14sp"
                tools:text="2025-12-19 16:04:39"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_label_time"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Amount -->
            <TextView
                android:id="@+id/tv_label_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:text="提现金额"
                android:textColor="#333333"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_label_time" />

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="#333333"
                android:textSize="14sp"
                tools:text="0.10元"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_label_amount"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_back"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginHorizontal="68dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/shape_btn_orange"
        android:text="返回"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_content" />

</androidx.constraintlayout.widget.ConstraintLayout>
