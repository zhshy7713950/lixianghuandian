<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 主弹窗容器 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popupContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginRight="60dp"
        android:layout_gravity="top"
        android:layout_marginTop="180dp"
        android:background="@drawable/bg_warning_alert_popup">

        <!-- 温馨提示标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="温馨提示"
            android:textColor="#000000"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- 原因说明 -->
        <TextView
            android:id="@+id/tvReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="30dp"
            android:text="由于电池或者保护板高温，您的电池即将或者已经断电"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- 处理办法 -->
        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:text="请您立即停止行驶，并将电池取出，静置3~5分钟，等待温度恢复正常后，即可重新放电继续使用"
            android:textColor="#FF0000"
            android:textSize="16sp"
            android:gravity="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReason" />

        <!-- 好的按钮 -->
        <com.flyco.roundview.RoundTextView
            android:id="@+id/btnOk"
            android:layout_width="120dp"
            android:layout_height="34dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="好的"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            app:rv_backgroundColor="#FF0000"
            app:rv_cornerRadius="17dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSolution"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 感叹号图标 -->
    <ImageView
        android:id="@+id/ivWarningIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@mipmap/ic_alert"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="150dp" />

</FrameLayout>
